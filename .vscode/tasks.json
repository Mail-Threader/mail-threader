{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": ["-m", "pytest", "tests", "-v"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "Run Tests with Coverage",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": ["-m", "pytest", "tests", "--cov=src", "--cov-report=html"],
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "Format Code",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": ["-m", "yapf", "--in-place", "--recursive", "src", "tests"],
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "Build Documentation",
			"type": "shell",
			"command": "cd docs && ${command:python.interpreterPath} -m sphinx.cmd.build -b html source build/html",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			}
		}
	]
}
